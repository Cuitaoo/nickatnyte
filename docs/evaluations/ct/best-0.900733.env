# Best measured configuration on this branch.
#
#   public 200         score 0.900733  Hit@10 0.990  MRR 0.835776  MTTC 3.250
#   holdout pop-matched score 0.868402  Hit@10 0.965  MRR 0.780673  MTTC 3.415
#   API tokens ~50k per 200 sessions (ambiguity gate active)
#
# Usage — the API key is deliberately NOT in this file:
#   set -a; source docs/evaluations/ct/best-0.900733.env; export OPENAI_API_KEY=...; set +a
#
# .env.example defaults most of these OFF, so this snapshot is what makes
# the score reproducible. See improvement-backlog.md for the measurement
# behind each one.

OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
OPENAI_ENABLED=true

TECHJAM_DEFER_LOW_CONFIDENCE_RECOMMENDATIONS=true
TECHJAM_DEFER_MAX_TURN=3
TECHJAM_DEFER_MAX_NON_CATEGORY_PREFERENCES=1
TECHJAM_DEFER_MIN_CANDIDATE_COUNT=2
TECHJAM_DEFER_MIN_TOP_ROUTE_COUNT_TO_RECOMMEND=99

# Progressive disclosure: cap returned candidates per turn, widening as
# constraints accumulate. Applies only on turns that also ask a question.
# Measured +0.0214 public / +0.0098 held-out synthetic vs unset.
TECHJAM_DEPTH_SCHEDULE=1,2,3,5,10

# Audience guardrail: demote wrong-department products after reranking.
# Public set score-neutral; held-out synthetic +0.0050 (hit@10 0.950->0.955).
# Cuts visibly wrong-audience items in the top 10 from 16.6% to 7.9%.
TECHJAM_AUDIENCE_GUARDRAIL=true
TECHJAM_AUDIENCE_PENALTY=0.30
TECHJAM_AUDIENCE_TOP_N=20

# Ask "other" early: straight after an intent override, and once the shopper
# has said "no preference" to 2 specific attributes. +0.0150 public
# (Hit@10 0.985->0.990, MTTC 3.885->3.565), +0.0039 held-out synthetic.
TECHJAM_OTHER_AFTER_OVERRIDE=true
TECHJAM_OTHER_AFTER_NO_PREFERENCE=2

# Confidence controller: replaces pure turn-count deferral with measured
# separability (top-1/top-2 margin, route agreement, fallback presence). It may
# only RELEASE a turn the rule would withhold, never withhold one the rule
# would release, so MTTC cannot worsen. At margin 0.60 it releases only turns
# whose ranking is so separated that MRR is untouched on both sets:
#   public   +0.000600  (MRR unchanged, MTTC 3.570 -> 3.540)
#   held-out +0.000400  (MRR unchanged, MTTC 3.635 -> 3.615)
# Lower thresholds gain more MTTC but cost MRR and go negative held-out.
TECHJAM_CONFIDENCE_CONTROLLER=true
TECHJAM_CONFIDENCE_MIN_MARGIN=0.20
TECHJAM_CONFIDENCE_MIN_ROUTES=2
TECHJAM_CONFIDENCE_STARVED_POOL=3
# Over-generality detection. Recorded always; acting on it (withholding) is
# separate and measured -0.000200, so it stays off.
TECHJAM_CONFIDENCE_OVERLOAD_POOL=400
TECHJAM_CONFIDENCE_OVERLOAD_CUTOFF=false

# Deterministic recommendation explanations in the response message, built from
# recorded match evidence. Score-neutral: message text is not parsed.
TECHJAM_EXPLANATIONS=true

# Staged hard filtering: a buying shopper's volunteered requirement removes
# products rather than nudging them. Enabled to fulfil the dual-track pillar -
# buying genuinely takes a different path. Costs -0.001198 public / -0.000550
# held-out, both noise, with Hit@10 untouched on either set.
TECHJAM_STAGED_FILTER=true
TECHJAM_STAGED_FILTER_MIN_POOL=40
TECHJAM_STAGED_FILTER_MIN_CONFIDENCE=0.75
TECHJAM_STAGED_FILTER_AFTER_RERANK=true

# Inverse document frequency on constraint values. "Imported" is true of most
# of the catalogue and must not carry the ranking force of a model number.
# Damps the confirmed-preference boost by how common the value's rarest token
# is: Imported 0.541, Zipper closure 0.875, 100% Cotton 0.707, a distinctive
# phrase or SKU ~1.0. +0.000134 public / +0.003600 held-out, and it generalises
# better than it scores here - intent_override MRR +0.0196 public, +0.0333
# held-out, with held-out Hit@10 rising 0.950 -> 0.955.
TECHJAM_IDF_WEIGHTING=true
TECHJAM_IDF_MIN_SCALE=0.35
TECHJAM_IDF_DAMP=1.5

# Measured and rejected, kept switchable as evidence:
# OVERRIDE_REINFORCES treats an override restating a known value as
#   reinforcement rather than replacement. -0.000150, and intent_override MRR
#   -0.0167: the erasure it avoids was doing useful work.
# REASK_WHEN_EXHAUSTED re-asks the most separating attribute once every
#   question is spent. Exactly 0.000000 - re-asking a declined attribute just
#   earns another "no preference"; you cannot extract what is not there.
TECHJAM_OVERRIDE_REINFORCES=false
TECHJAM_REASK_WHEN_EXHAUSTED=false

# Quality/popularity signal. The tuned default (0.000335) is effectively off.
# Raising it is the single largest gain measured: +0.014675 public and
# +0.018603 on a popularity-matched holdout.
#
# IMPORTANT: the uniform synthetic holdout reports this as NEGATIVE (-0.003094)
# and is wrong to. Public targets have a median of 6,846 ratings against a
# catalogue median of 12, because the benchmark anchors on real purchases and
# real purchases skew popular. data/synthetic_set.jsonl samples the catalogue
# uniformly, so it is mis-specified on exactly this axis. Validate anything
# popularity-correlated against data/synthetic_pop.jsonl instead.
TECHJAM_RATING_COUNT_COEF=0.030

TECHJAM_RERANK_ENABLED=true
TECHJAM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
TECHJAM_RERANK_TOP_N=10
TECHJAM_RERANK_BATCH_SIZE=16
TECHJAM_RERANK_WEIGHT=0.65
TECHJAM_RERANK_LOCAL_ONLY=true
TECHJAM_RERANK_TEXT_FORMAT=legacy

TECHJAM_VECTOR_ENABLED=true
TECHJAM_VECTOR_INDEX_DIR=data/vector_index
TECHJAM_VECTOR_TOP_K=30
TECHJAM_VECTOR_WEIGHT=0
TECHJAM_VECTOR_CATEGORY_WEIGHT=0
TECHJAM_VECTOR_FEATURE_WEIGHT=0.05
TECHJAM_VECTOR_RECALL_ONLY=true
TECHJAM_VECTOR_POLICY=adaptive
TECHJAM_VECTOR_MAX_DOC_FREQUENCY=750
TECHJAM_VECTOR_MIN_RARE_TERMS=1
TECHJAM_VECTOR_LOW_CONFIDENCE_CANDIDATES=40
TECHJAM_VECTOR_HIGH_CONFIDENCE_ROUTES=3
TECHJAM_VECTOR_MIN_SIMILARITY=0.45
