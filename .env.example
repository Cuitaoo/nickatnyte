# Winning configuration, verified: sourcing this file alone (plus your own
# OPENAI_API_KEY) reproduces the measured result.
#
#   public 200           score 0.914524  Hit@10 0.990  MRR 0.901415  MTTC 3.545
#   holdout pop-matched  score 0.876643  Hit@10 0.955  MRR 0.852476  MTTC 3.830
#   ~50k API tokens per 200 sessions, with the ambiguity gate active
#
# Settings left at false/empty below are features that were built and measured
# NEGATIVE; each carries its numbers in the comment above it. They are kept
# switchable as evidence, not as suggestions.
#
# See docs/evaluations/ct/improvement-backlog.md for the full measurement log.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
OPENAI_ENABLED=true
OPENAI_AMBIGUITY_GATE_ENABLED=true

# Experimental scenario-aware query expansion. The existing ambiguity call may
# emit temporary, confidence-gated scenario hypotheses. They never enter
# confirmed state or profile memory. The deterministic category and confirmed
# feature routes stay separate; `recall` adds only a low-weight feature-vector
# scenario route. Default OFF until public and popularity-matched holdout
# benchmarks both validate it.
TECHJAM_QUERY_EXPANSION_ENABLED=false
TECHJAM_QUERY_EXPANSION_MODE=shadow
TECHJAM_QUERY_EXPANSION_MIN_CONFIDENCE=0.60
TECHJAM_QUERY_EXPANSION_MAX_HYPOTHESES=3

TECHJAM_DEFER_LOW_CONFIDENCE_RECOMMENDATIONS=true
TECHJAM_DEFER_MAX_TURN=3
TECHJAM_DEFER_MAX_NON_CATEGORY_PREFERENCES=1
TECHJAM_DEFER_MIN_CANDIDATE_COUNT=2
TECHJAM_DEFER_MIN_TOP_ROUTE_COUNT_TO_RECOMMEND=99
# Deferral is deliberately off for buying intent: enabling it measured -0.0011.
TECHJAM_DEFER_INCLUDE_BUYING=false

# Per-turn cap on returned candidates, widening as the session gathers
# constraints. Comma-separated depths from turn 1, last value repeats; empty
# disables truncation. Applies only on turns that also ask a question.
TECHJAM_DEPTH_SCHEDULE=1,2,3,5,10
# Optional separate schedule for buying sessions; measured +0.002 (noise).
TECHJAM_DEPTH_SCHEDULE_BUYING=

# Final ranking guardrail: demote products sold to a different audience than
# the shopper asked for (the catalog skews ~2.4:1 womens, so mens/boys queries
# leak). Soft by design - a strong exact/identifier match still outranks it.
# Penalty is the fraction of the top-N window a full mismatch falls.
TECHJAM_AUDIENCE_GUARDRAIL=true
TECHJAM_AUDIENCE_PENALTY=0.30
TECHJAM_AUDIENCE_TOP_N=20

# Ask the open-ended "other" question before the specific facets are
# exhausted. "other" accepts any undisclosed constraint while a specific
# attribute only accepts its own kind, so promoting it harvests details that
# do not fit the standard facets. Measured +0.0150 public / +0.0039 held-out.
# Both default ON. Triggers read structured state (last_update_type and
# consecutive_no_preference_turns), not the raw message.
TECHJAM_OTHER_AFTER_OVERRIDE=true
# 0 disables; 2 measured best (1 scores the same but costs Hit@10).
TECHJAM_OTHER_AFTER_NO_PREFERENCE=2
# Count every declined attribute (true) or only consecutive ones (false).
# Cumulative measured +0.001900 over consecutive.
TECHJAM_OTHER_COUNTER_CUMULATIVE=true

# Dual-track routing: buying gets a precision operating point (confirmed
# attributes and exact phrases up, pool-widening routes down); browsing is
# opt-in and off, being already the strongest scenario. Override turns stay
# neutral. MEASURED NEGATIVE on both sets - see improvement-backlog.md. The
# weights trade Hit@10 for MRR and the composite prefers the target. Kept
# default-off; the genuine buying path needs staged constraint filtering,
# not different constants.
TECHJAM_DUAL_TRACK=false
TECHJAM_DUAL_TRACK_STRENGTH=1.0
TECHJAM_DUAL_TRACK_BROWSING=false
# Category-capped result selection. Costs Hit@10 0.988 -> 0.938 on browsing.
TECHJAM_DUAL_TRACK_DIVERSITY=false

# Semantic profile expansion: expand aggregate profile tags into catalog
# vocabulary (comfort -> cushioned/breathable/soft), scaled by intent, with
# matched tags recorded for explainability. MEASURED NEGATIVE on held-out and
# left off - see improvement-backlog.md. The four commonest tags fire on ~half
# the catalogue each, so they act as a near-uniform boost. Needs IDF weighting
# before it can carry signal.
TECHJAM_PROFILE_SEMANTIC=false
# Post-truncation reorder: permutes the returned list only, so Hit@10 and MTTC
# are provably frozen. Mechanism verified; the profile signal is too common to
# rank with, so this measured MRR -0.021. Off until the tags are IDF-weighted.
TECHJAM_PROFILE_REORDER=false
TECHJAM_PROFILE_REORDER_GAIN=2.5
TECHJAM_PROFILE_MAX_BUYING=0.015
TECHJAM_PROFILE_MAX_BROWSING=0.18
TECHJAM_PROFILE_MAX_UNKNOWN=0.08

# Confidence controller: replaces pure turn-count deferral with measured
# separability (top-1/top-2 margin, route agreement, fallback presence). It may
# only RELEASE a turn the rule would withhold, never withhold one the rule
# would release, so MTTC cannot worsen. At margin 0.60 it releases only turns
# whose ranking is so separated that MRR is untouched on both sets:
#   public   +0.000600  (MRR unchanged, MTTC 3.570 -> 3.540)
#   held-out +0.000400  (MRR unchanged, MTTC 3.635 -> 3.615)
# Lower thresholds gain more MTTC but cost MRR and go negative held-out.
TECHJAM_CONFIDENCE_CONTROLLER=true
TECHJAM_CONFIDENCE_MIN_MARGIN=0.20
TECHJAM_CONFIDENCE_MIN_ROUTES=2
TECHJAM_CONFIDENCE_STARVED_POOL=3
# Over-generality detection. Recorded always; acting on it (withholding) is
# separate and measured -0.000200, so it stays off.
TECHJAM_CONFIDENCE_OVERLOAD_POOL=400
TECHJAM_CONFIDENCE_OVERLOAD_CUTOFF=false
# Over-generality steering the next question. Measured negative both ways and
# left off; see improvement-backlog.md. The existing question policy already
# balances split power against answerability better than either variant.
TECHJAM_OVERLOAD_QUESTION_STEERING=false
TECHJAM_OVERLOAD_W_DISAGREE=0.55
TECHJAM_OVERLOAD_W_PRIOR=1.0
TECHJAM_OVERLOAD_QUESTION_MIN=0.28

# Deterministic recommendation explanations in the response message, built from
# recorded match evidence. Score-neutral: message text is not parsed.
TECHJAM_EXPLANATIONS=true

# Staged hard filtering for the buying path. Constraint strength typing works
# (88% of buying sessions yield a hard constraint) but filtering on top of the
# existing confirmed-attribute boost changes only 7/200 sessions and measures
# -0.0012, dominated by one session. Off; see improvement-backlog.md.
TECHJAM_STAGED_FILTER=true
TECHJAM_STAGED_FILTER_MIN_POOL=40
TECHJAM_STAGED_FILTER_MIN_CONFIDENCE=0.75
TECHJAM_STAGED_FILTER_AFTER_RERANK=true

# Inverse document frequency on constraint values. "Imported" is true of most
# of the catalogue and must not carry the ranking force of a model number.
# Damps the confirmed-preference boost by how common the value's rarest token
# is: Imported 0.541, Zipper closure 0.875, 100% Cotton 0.707, a distinctive
# phrase or SKU ~1.0. +0.000134 public / +0.003600 held-out, and it generalises
# better than it scores here - intent_override MRR +0.0196 public, +0.0333
# held-out, with held-out Hit@10 rising 0.950 -> 0.955.
TECHJAM_IDF_WEIGHTING=true
TECHJAM_IDF_MIN_SCALE=0.35
TECHJAM_IDF_DAMP=1.5

# Measured and rejected, kept switchable as evidence:
# OVERRIDE_REINFORCES treats an override restating a known value as
#   reinforcement rather than replacement. -0.000150, and intent_override MRR
#   -0.0167: the erasure it avoids was doing useful work.
# REASK_WHEN_EXHAUSTED re-asks the most separating attribute once every
#   question is spent. Exactly 0.000000 - re-asking a declined attribute just
#   earns another "no preference"; you cannot extract what is not there.
TECHJAM_OVERRIDE_REINFORCES=false
TECHJAM_REASK_WHEN_EXHAUSTED=false

# Quality/popularity signal. The tuned default (0.000335) is effectively off.
# Raising it is the single largest gain measured: +0.014675 public and
# +0.018603 on a popularity-matched holdout.
#
# IMPORTANT: the uniform synthetic holdout reports this as NEGATIVE (-0.003094)
# and is wrong to. Public targets have a median of 6,846 ratings against a
# catalogue median of 12, because the benchmark anchors on real purchases and
# real purchases skew popular. data/synthetic_set.jsonl samples the catalogue
# uniformly, so it is mis-specified on exactly this axis. Validate anything
# popularity-correlated against data/synthetic_pop.jsonl instead.
TECHJAM_RATING_COUNT_COEF=0.030

# How the returned-list cap is chosen. "hybrid" caps by measured separability
# instead of by turn number: reciprocal rank freezes at the target's first
# appearance, so the list should widen when the ranking has actually separated,
# not when the clock says so. Calibrated against how often the leader really is
# the target (70 sessions x 5 turns):
#   margin >=0.60 -> 96.5% correct -> return 10
#   margin >=0.20 -> 54.5%         -> return 2
#   below         -> 13-31%        -> return 1
# Turn 5 always widens to 10, because a miss costs the full 11-turn penalty.
# Measured +0.011491 public / +0.008855 held-out over the turn schedule.
TECHJAM_DEPTH_MODE=hybrid
# Scale-free: the gap as a fraction of the leading score, so the thresholds
# keep their meaning if RetrievalWeights is ever retuned. Calibrated on
# top-1 accuracy: ratio >=0.30 -> 97.9%, 0.20-0.30 -> 92.3%, 0.10-0.20 ->
# 66.7%, below -> 32.0%.
TECHJAM_DEPTH_NORMALIZED_MARGIN=true
TECHJAM_DEPTH_RATIO_WIDE=0.30
TECHJAM_DEPTH_RATIO_MID=0.10
# Raw-margin fallback, used only if NORMALIZED_MARGIN is false.
TECHJAM_DEPTH_MARGIN_WIDE=0.60
TECHJAM_DEPTH_MARGIN_MID=0.20
TECHJAM_DEPTH_FLOOR_TURN=5

TECHJAM_RERANK_ENABLED=true
TECHJAM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
TECHJAM_RERANK_TOP_N=10
TECHJAM_RERANK_BATCH_SIZE=16
TECHJAM_RERANK_WEIGHT=0.65
TECHJAM_RERANK_LOCAL_ONLY=true
TECHJAM_RERANK_TEXT_FORMAT=legacy

TECHJAM_VECTOR_ENABLED=true
TECHJAM_VECTOR_INDEX_DIR=data/vector_index
TECHJAM_VECTOR_TOP_K=30
TECHJAM_VECTOR_WEIGHT=0
TECHJAM_VECTOR_CATEGORY_WEIGHT=0
TECHJAM_VECTOR_FEATURE_WEIGHT=0.05
TECHJAM_VECTOR_RECALL_ONLY=true
# Applied only to enabled scenario-query routes. Smaller than the lexical
# category route, so inferred context cannot replace explicit product evidence.
TECHJAM_SCENARIO_VECTOR_WEIGHT=0.25
TECHJAM_VECTOR_POLICY=adaptive
TECHJAM_VECTOR_MAX_DOC_FREQUENCY=750
TECHJAM_VECTOR_MIN_RARE_TERMS=1
TECHJAM_VECTOR_LOW_CONFIDENCE_CANDIDATES=40
TECHJAM_VECTOR_HIGH_CONFIDENCE_ROUTES=3
TECHJAM_VECTOR_MIN_SIMILARITY=0.45
