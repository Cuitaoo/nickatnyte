OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
OPENAI_ENABLED=true

TECHJAM_DEFER_LOW_CONFIDENCE_RECOMMENDATIONS=true
TECHJAM_DEFER_MAX_TURN=3
TECHJAM_DEFER_MAX_NON_CATEGORY_PREFERENCES=1
TECHJAM_DEFER_MIN_CANDIDATE_COUNT=2
TECHJAM_DEFER_MIN_TOP_ROUTE_COUNT_TO_RECOMMEND=99
# Deferral is deliberately off for buying intent: enabling it measured -0.0011.
TECHJAM_DEFER_INCLUDE_BUYING=false

# Per-turn cap on returned candidates, widening as the session gathers
# constraints. Comma-separated depths from turn 1, last value repeats; empty
# disables truncation. Applies only on turns that also ask a question.
TECHJAM_DEPTH_SCHEDULE=
# Optional separate schedule for buying sessions; measured +0.002 (noise).
TECHJAM_DEPTH_SCHEDULE_BUYING=

# Final ranking guardrail: demote products sold to a different audience than
# the shopper asked for (the catalog skews ~2.4:1 womens, so mens/boys queries
# leak). Soft by design - a strong exact/identifier match still outranks it.
# Penalty is the fraction of the top-N window a full mismatch falls.
TECHJAM_AUDIENCE_GUARDRAIL=false
TECHJAM_AUDIENCE_PENALTY=0.15
TECHJAM_AUDIENCE_TOP_N=20

# Ask the open-ended "other" question before the specific facets are
# exhausted. "other" accepts any undisclosed constraint while a specific
# attribute only accepts its own kind, so promoting it harvests details that
# do not fit the standard facets. Measured +0.0150 public / +0.0039 held-out.
# Both default ON. Triggers read structured state (last_update_type and
# consecutive_no_preference_turns), not the raw message.
TECHJAM_OTHER_AFTER_OVERRIDE=true
# 0 disables; 2 measured best (1 scores the same but costs Hit@10).
TECHJAM_OTHER_AFTER_NO_PREFERENCE=2
# Count every declined attribute (true) or only consecutive ones (false).
# Cumulative measured +0.001900 over consecutive.
TECHJAM_OTHER_COUNTER_CUMULATIVE=true

# Dual-track routing: buying gets a precision operating point (confirmed
# attributes and exact phrases up, pool-widening routes down); browsing is
# opt-in and off, being already the strongest scenario. Override turns stay
# neutral. MEASURED NEGATIVE on both sets - see improvement-backlog.md. The
# weights trade Hit@10 for MRR and the composite prefers the target. Kept
# default-off; the genuine buying path needs staged constraint filtering,
# not different constants.
TECHJAM_DUAL_TRACK=false
TECHJAM_DUAL_TRACK_STRENGTH=1.0
TECHJAM_DUAL_TRACK_BROWSING=false
# Category-capped result selection. Costs Hit@10 0.988 -> 0.938 on browsing.
TECHJAM_DUAL_TRACK_DIVERSITY=false

# Semantic profile expansion: expand aggregate profile tags into catalog
# vocabulary (comfort -> cushioned/breathable/soft), scaled by intent, with
# matched tags recorded for explainability. MEASURED NEGATIVE on held-out and
# left off - see improvement-backlog.md. The four commonest tags fire on ~half
# the catalogue each, so they act as a near-uniform boost. Needs IDF weighting
# before it can carry signal.
TECHJAM_PROFILE_SEMANTIC=false
TECHJAM_PROFILE_MAX_BUYING=0.015
TECHJAM_PROFILE_MAX_BROWSING=0.18
TECHJAM_PROFILE_MAX_UNKNOWN=0.08

TECHJAM_RERANK_ENABLED=false
TECHJAM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
TECHJAM_RERANK_TOP_N=10
TECHJAM_RERANK_BATCH_SIZE=16
TECHJAM_RERANK_WEIGHT=0.65
TECHJAM_RERANK_LOCAL_ONLY=true
TECHJAM_RERANK_TEXT_FORMAT=legacy

TECHJAM_VECTOR_ENABLED=false
TECHJAM_VECTOR_INDEX_DIR=data/vector_index
TECHJAM_VECTOR_TOP_K=30
TECHJAM_VECTOR_WEIGHT=0
TECHJAM_VECTOR_CATEGORY_WEIGHT=0
TECHJAM_VECTOR_FEATURE_WEIGHT=0.05
TECHJAM_VECTOR_RECALL_ONLY=true
TECHJAM_VECTOR_POLICY=adaptive
TECHJAM_VECTOR_MAX_DOC_FREQUENCY=750
TECHJAM_VECTOR_MIN_RARE_TERMS=1
TECHJAM_VECTOR_LOW_CONFIDENCE_CANDIDATES=40
TECHJAM_VECTOR_HIGH_CONFIDENCE_ROUTES=3
TECHJAM_VECTOR_MIN_SIMILARITY=0.45
