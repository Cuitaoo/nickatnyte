# The tuned configuration is compiled into starter/config.py, not this file.
# A fresh clone reproduces the reported score with nothing set up at all.
#
# The only thing that belongs in the environment is the secret:

OPENAI_API_KEY=

# Leave it empty and the agent runs fully offline on the deterministic parser
# (-0.0002 on the public set). Nothing else is required.
#
# Every setting in starter/config.py can still be overridden by exporting it,
# which is how the ablations in the README work. For example:
#
#   OPENAI_ENABLED=false ...          # no network calls at all
#   TECHJAM_RATING_COUNT_COEF=0.000335 ...   # drop the popularity prior
#
# Check what your shell is actually doing with:
#
#   PYTHONPATH=. python tools/verify_setup.py --catalog data/catalog.jsonl
